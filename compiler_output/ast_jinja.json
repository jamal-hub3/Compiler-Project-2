{,
  "jinja_ast_index": "╔═══════════════════════════════════════════╗\n║    JINJA2 AST — Template: index.jinja      ║\n╚═══════════════════════════════════════════╝\n  [Jinja2Extends] (L1:C0) parent=\"base.jinja\"\n  [Jinja2Block] (L2:C0) name=\"title\"\n    [Jinja2RawText] (L2:C17) \"Products\"\n  [/Block:title]\n  [Jinja2Block] (L3:C0) name=\"content\"\n    [Jinja2HtmlElement] (L4:C0) <h2 style=\"text-align:center; margin-bottom:20px;\">\n      [Jinja2RawText] (L4:C51) \"Products List\"\n    [Jinja2HtmlElement] (L5:C0) <div style=\"text-align:center; margin-bottom:20px;\">\n      [Jinja2HtmlElement] (L6:C4) <a href=\"{{ url_for('add_product') }}\" class=\"btn btn-success\">\n        [Jinja2RawText] (L6:C67) \"+ Add New Product\"\n    [Jinja2HtmlElement] (L8:C0) <div class=\"product-grid\">\n      [Jinja2For] (L9:C4) for product in products\n        [Jinja2HtmlElement] (L10:C4) <div class=\"product-card\">\n          [Jinja2HtmlElement] (L11:C8) <img src=\"{{ product.image }}\" alt=\"{{ product.name }}\">\n          [Jinja2HtmlElement] (L12:C8) <h3>\n            [Jinja2Variable] (L12:C12) {{ product.name }}\n          [Jinja2HtmlElement] (L13:C8) <p>\n            [Jinja2RawText] (L13:C11) \"Price: $\"\n            [Jinja2Variable] (L13:C19) {{ product.price }}\n          [Jinja2HtmlElement] (L14:C8) <a href=\"{{ url_for('product_detail', product_id=product.id) }}\" class=\"btn btn-primary\">\n            [Jinja2RawText] (L14:C97) \"View Details\"\n          [Jinja2HtmlElement] (L15:C8) <a href=\"{{ url_for('edit_product', product_id=product.id) }}\" class=\"btn btn-warning\">\n            [Jinja2RawText] (L15:C95) \"Edit\"\n          [Jinja2HtmlElement] (L16:C8) <a href=\"{{ url_for('delete_product', product_id=product.id) }}\" class=\"btn btn-danger\" onclick=\"return confirm('Delete this product?')\">\n            [Jinja2RawText] (L17:C60) \"Delete\"\n      [/For]\n  [/Block:content]\n",
  "jinja_ast_add_product": "╔═══════════════════════════════════════════╗\n║    JINJA2 AST — Template: add_product.jinja ║\n╚═══════════════════════════════════════════╝\n  [Jinja2Extends] (L1:C0) parent=\"base.jinja\"\n  [Jinja2Block] (L2:C0) name=\"title\"\n    [Jinja2RawText] (L2:C17) \"Add Product\"\n  [/Block:title]\n  [Jinja2Block] (L3:C0) name=\"content\"\n    [Jinja2HtmlElement] (L4:C0) <h2 style=\"text-align:center; margin-bottom:20px;\">\n      [Jinja2RawText] (L4:C51) \"Add New Product\"\n    [Jinja2HtmlElement] (L5:C0) <form method=\"POST\">\n      [Jinja2HtmlElement] (L6:C4) <label>\n        [Jinja2RawText] (L6:C11) \"Product Name:\"\n      [Jinja2HtmlElement] (L7:C4) <input type=\"text\" name=\"name\" placeholder=\"e.g. Laptop Pro\" required=\"\">\n      [Jinja2HtmlElement] (L9:C4) <label>\n        [Jinja2RawText] (L9:C11) \"Description:\"\n      [Jinja2HtmlElement] (L10:C4) <textarea name=\"description\" rows=\"3\" placeholder=\"Product description...\" required=\"\">\n      [Jinja2HtmlElement] (L12:C4) <label>\n        [Jinja2RawText] (L12:C11) \"Price ($):\"\n      [Jinja2HtmlElement] (L13:C4) <input type=\"number\" name=\"price\" step=\"0.01\" min=\"0\" placeholder=\"0.00\" required=\"\">\n      [Jinja2HtmlElement] (L15:C4) <label>\n        [Jinja2RawText] (L15:C11) \"Image URL (optional):\"\n      [Jinja2HtmlElement] (L16:C4) <input type=\"text\" name=\"image\" placeholder=\"https://...\">\n      [Jinja2HtmlElement] (L18:C4) <button type=\"submit\">\n        [Jinja2RawText] (L18:C26) \"Add Product\"\n      [Jinja2HtmlElement] (L19:C4) <a href=\"{{ url_for('index') }}\" class=\"back-link\" style=\"margin-left:15px;\">\n        [Jinja2RawText] (L19:C81) \"&larr; Cancel\"\n  [/Block:content]\n",
  "jinja_ast_edit_product": "╔═══════════════════════════════════════════╗\n║    JINJA2 AST — Template: edit_product.jinja ║\n╚═══════════════════════════════════════════╝\n  [Jinja2Extends] (L1:C0) parent=\"base.jinja\"\n  [Jinja2Block] (L2:C0) name=\"title\"\n    [Jinja2RawText] (L2:C17) \"Edit Product\"\n  [/Block:title]\n  [Jinja2Block] (L3:C0) name=\"content\"\n    [Jinja2HtmlElement] (L4:C0) <h2 style=\"text-align:center; margin-bottom:20px;\">\n      [Jinja2RawText] (L4:C51) \"Edit Product\"\n    [Jinja2HtmlElement] (L5:C0) <form method=\"POST\">\n      [Jinja2HtmlElement] (L6:C4) <label>\n        [Jinja2RawText] (L6:C11) \"Product Name:\"\n      [Jinja2HtmlElement] (L7:C4) <input type=\"text\" name=\"name\" value=\"{{ product.name }}\" required=\"\">\n      [Jinja2HtmlElement] (L9:C4) <label>\n        [Jinja2RawText] (L9:C11) \"Description:\"\n      [Jinja2HtmlElement] (L10:C4) <textarea name=\"description\" rows=\"3\" required=\"\">\n        [Jinja2Variable] (L10:C51) {{ product.description }}\n      [Jinja2HtmlElement] (L12:C4) <label>\n        [Jinja2RawText] (L12:C11) \"Price ($):\"\n      [Jinja2HtmlElement] (L13:C4) <input type=\"number\" name=\"price\" step=\"0.01\" min=\"0\" value=\"{{ product.price }}\" required=\"\">\n      [Jinja2HtmlElement] (L15:C4) <label>\n        [Jinja2RawText] (L15:C11) \"Image URL (optional):\"\n      [Jinja2HtmlElement] (L16:C4) <input type=\"text\" name=\"image\" value=\"{{ product.image }}\">\n      [Jinja2HtmlElement] (L18:C4) <button type=\"submit\">\n        [Jinja2RawText] (L18:C26) \"Save Changes\"\n      [Jinja2HtmlElement] (L19:C4) <a href=\"{{ url_for('index') }}\" class=\"back-link\" style=\"margin-left:15px;\">\n        [Jinja2RawText] (L19:C81) \"&larr; Cancel\"\n  [/Block:content]\n"
}
{% extends "base.jinja" %}
{% block title %}Add Product{% endblock %}
{% block content %}
<h2 style="text-align:center; margin-bottom:20px;">Add New Product</h2>
<form method="POST">
    <label>Product Name:</label>
    <input type="text" name="name" placeholder="e.g. Laptop Pro" required />

    <label>Description:</label>
    <textarea name="description" rows="3" placeholder="Product description..." required></textarea>

    <label>Price ($):</label>
    <input type="number" name="price" step="0.01" min="0" placeholder="0.00" required />

    <label>Image URL (optional):</label>
    <input type="text" name="image" placeholder="https://..." />

    <button type="submit">Add Product</button>
    <a href="{{ url_for('index') }}" class="back-link" style="margin-left:15px;">&larr; Cancel</a>
</form>
{% endblock %}

{% extends "base.jinja" %}
{% block title %}Edit Product{% endblock %}
{% block content %}
<h2 style="text-align:center; margin-bottom:20px;">Edit Product</h2>
<form method="POST">
    <label>Product Name:</label>
    <input type="text" name="name" value="{{ product.name }}" required />

    <label>Description:</label>
    <textarea name="description" rows="3" required>{{ product.description }}</textarea>

    <label>Price ($):</label>
    <input type="number" name="price" step="0.01" min="0" value="{{ product.price }}" required />

    <label>Image URL (optional):</label>
    <input type="text" name="image" value="{{ product.image }}" />

    <button type="submit">Save Changes</button>
    <a href="{{ url_for('index') }}" class="back-link" style="margin-left:15px;">&larr; Cancel</a>
</form>
{% endblock %}
